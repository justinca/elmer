# ============================================================
# Elmer — Environment Configuration (configs directory copy)
# See root .env.example for the primary template
# ============================================================

# --- Elmer Core (NUC) ---
ELMER_CORE_HOST=0.0.0.0
ELMER_CORE_PORT=8100

# --- Elmer Worker (Windows Desktop) ---
ELMER_WORKER_HOST=192.168.x.x
ELMER_WORKER_PORT=8101

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=elmer
POSTGRES_PASSWORD=changeme
POSTGRES_DB=elmer

# --- MQTT Broker ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- Ollama (LLM) ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Obsidian Vault (Knowledge Base) ---
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
