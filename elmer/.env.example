# ============================================================
# Elmer — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# --- Elmer Core (NUC) ----------------------------------------
ELMER_CORE_HOST=0.0.0.0
ELMER_CORE_PORT=8100

# --- Elmer Worker (Windows Desktop) --------------------------
# LAN IP of the Windows machine running the GPU worker
ELMER_WORKER_HOST=192.168.x.x
ELMER_WORKER_PORT=8101

# --- PostgreSQL (native install, not Docker) ------------------
# Runs on the NUC directly — do NOT add to docker-compose.yml
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=elmer

# --- MQTT Broker (existing Mosquitto container) ---------------
# Mosquitto runs in the existing NUC Docker Compose stack.
# With network_mode: host, containers reach it at localhost:1883.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=w0abe
MQTT_PASSWORD=meshtastic

# --- Ollama (LLM) --------------------------------------------
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# --- Telegram Bot ---------------------------------------------
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Obsidian Vault (Knowledge Base) -------------------------
# Absolute path on the NUC to the Obsidian vault for indexing.
# Mounted read-only into the elmer-knowledge container.
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
